# ============================================================
# CPEDS-X backend environment
# Copy this file to `.env` (same folder) and fill in values.
# `.env` is git-ignored. main.py auto-loads it on startup.
# ============================================================

# ---- Session signing key (REQUIRED in production) ----------
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ---- Storage backend --------------------------------------
# Leave BOTH blank for local development -> the app uses a local SQLite file
# (backend/cpeds_users.db, created automatically, no setup).
#
# Set BOTH to use Supabase Postgres (required for Render/Vercel hosting, since
# their filesystems are ephemeral). See backend/supabase_schema.sql for setup.
#   SUPABASE_URL : Project Settings -> API -> Project URL
#   SUPABASE_KEY : Project Settings -> API -> service_role key  (secret!)
# The service_role key must stay server-side only — never put it in the frontend.
SUPABASE_URL=
SUPABASE_KEY=

# ---- Optional override -------------------------------------
# Force a backend regardless of the above: sqlite | supabase
# AUTH_STORE=sqlite
